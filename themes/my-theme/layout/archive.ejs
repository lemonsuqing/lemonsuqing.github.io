<section class="post-content" style="max-width: 800px; margin: 0 auto;">
    <h1 style="text-align:center; margin-bottom:40px; border-bottom:1px solid var(--border); padding-bottom:20px;">
        <% if(is_category()){ %>
            <i class="far fa-folder-open"></i> 分类: <%= page.category %>
        <% } else if(is_tag()){ %>
            <i class="fas fa-tag"></i> 标签: <%= page.tag %>
        <% } else { %>
            <i class="fas fa-history"></i> 文章归档
        <% } %>
    </h1>

    <div class="archive-list">
        <% page.posts.sort('date', -1).forEach(function(post){ %>
            <div class="archive-item">
                <div class="archive-date"><%= date(post.date, 'YYYY-MM-DD') %></div>
                <a href="<%- url_for(post.path) %>" class="archive-title"><%= post.title %></a>
            </div>
        <% }) %>
    </div>

    <div class="pagination">
        <%- paginator({ prev_text: '<', next_text: '>' }) %>
    </div>
</section>