<!-- Hero 区域 -->
<section class="hero">
    <h1>Welcome to <%= config.title %></h1>
    <p><%= config.subtitle || "分享技术，记录生活，探索未知。" %></p>
</section>

<!-- 最新文章 -->
<section>
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:30px; padding-bottom:20px; border-bottom: 2px solid var(--border-color);">
        <h2 style="margin:0; font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--text-primary);">
            <i class="fas fa-fire" style="color: var(--accent-gold); margin-right: 10px;"></i> 最新文章
        </h2>
    </div>

    <div class="post-grid">
        <% if (page.posts.length > 0) { %>
            <% page.posts.forEach(function(post){ %>
                <a href="<%- url_for(post.path) %>" class="card">
                    <div class="card-title"><%= post.title %></div>
                    <div class="card-meta">
                        <span><i class="far fa-calendar"></i> <%= date(post.date, 'YYYY-MM-DD') %></span>
                        <% if(post.categories && post.categories.length > 0){ %>
                            <span><i class="far fa-folder"></i> <%= post.categories.data[0].name %></span>
                        <% } %>
                    </div>
                    <div class="card-excerpt">
                        <% var excerpt = post.excerpt || post.content.replace(/<[^>]+>/g,"").substring(0, 100) + "..." %>
                        <%= excerpt %>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <div style="grid-column: 1 / -1; text-align:center; padding: 80px 20px; color: var(--text-secondary);">
                <i class="fas fa-inbox" style="font-size: 4rem; margin-bottom: 20px; color: var(--accent-gold);"></i>
                <p style="font-size: 1.2rem;">这里空空如也，快去写第一篇博客吧！</p>
            </div>
        <% } %>
    </div>

    <!-- 分页 -->
    <% if (page.total > 1){ %>
        <div class="pagination">
            <%- paginator({
                prev_text: '<i class="fas fa-chevron-left"></i> 上一页',
                next_text: '下一页 <i class="fas fa-chevron-right"></i>',
                escape: false
            }) %>
        </div>
    <% } %>
</section>