<!-- 通用单页模版 -->
<section class="post-content" style="max-width: 900px; margin: 0 auto; min-height: 60vh;">
    
    <div class="post-header" style="text-align: center; border-bottom: none; margin-bottom: 40px;">
        <h1 style="font-size: 2.5rem;"><%= page.title %></h1>
    </div>

    <div class="post-body">
        <!-- 场景1：标签页 (Tags) -->
        <% if (page.type === "tags") { %>
            <div class="tag-cloud">
                <!-- 调整了字体大小范围，去掉了颜色参数(交由CSS控制) -->
                <%- tagcloud({
                    min_font: 16, 
                    max_font: 24, 
                    amount: 200, 
                    color: false, 
                    unit: 'px',
                    class: 'tag-cloud'
                }) %>
            </div>

        <!-- 场景2：分类页 (Categories) -->
        <% } else if (page.type === "categories") { %>
            <div class="category-list-container">
                <%- list_categories({
                    show_count: true,
                    style: 'list',
                    class: 'category',
                    depth: 2
                }) %>
            </div>

        <!-- 场景3：普通页面 -->
        <% } else { %>
            <%- page.content %>
        <% } %>
    </div>

</section>