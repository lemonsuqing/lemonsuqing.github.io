<div class="post-layout">
    <!-- 左侧：文章内容 -->
    <article class="post-content">
        <div class="post-header">
            <h1><%= page.title %></h1>
            <div class="post-meta">
                <span><i class="far fa-calendar"></i> <%= date(page.date, 'YYYY-MM-DD') %></span>
                <% if(page.categories && page.categories.length){ %>
                    <span><i class="far fa-folder"></i> <%= page.categories.data[0].name %></span>
                <% } %>
                <% if(page.tags && page.tags.length){ %>
                    <span><i class="fas fa-tags"></i> 
                    <% page.tags.forEach(function(tag){ %> #<%= tag.name %> <% }) %>
                    </span>
                <% } %>
            </div>
        </div>

        <div class="post-body">
            <%- page.content %>
        </div>

        <div class="post-nav">
            <% if(page.prev){ %>
                <a href="<%- url_for(page.prev.path) %>" class="nav-btn">
                    <i class="fas fa-arrow-left"></i> <%= page.prev.title %>
                </a>
            <% } else { %> <div></div> <% } %>

            <% if(page.next){ %>
                <a href="<%- url_for(page.next.path) %>" class="nav-btn">
                    <%= page.next.title %> <i class="fas fa-arrow-right"></i>
                </a>
            <% } %>
        </div>
    </article>

    <!-- 右侧：悬浮目录 -->
    <aside class="sidebar">
        <div class="toc-container">
            <div class="toc-title">目录</div> <!-- 英文全大写更具设计感，或者用“目录” -->
            <%- toc(page.content, {
                list_number: false,
                max_depth: 6,
                min_depth: 1
            }) %>
        </div>
    </aside>
</div>